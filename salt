  command = "npm run build"
  publish = ".next"

[build.environment]
  NODE_VERSION = "20"

import type { NextConfig } from "next";
const config: NextConfig = {
  experimental: { serverActions: { bodySizeLimit: "2mb" } },
};
export default config;

